"""
Figure 3.1 - Original image dimensions and aspect ratio.

Motivates the aspect-preserving resize-and-pad step: absolute resolution
varies by roughly a hundred-fold in pixel count, while aspect ratio is
tightly clustered.

Input : outputs/data_check/dimension_report.csv   (written by step04)
Output: outputs/figures/fig_image_dimensions.{pdf,png}

Standalone: requires only pandas and matplotlib.

    python fig01_image_dimensions.py
    python fig01_image_dimensions.py --data-dir path/to/reports
"""

from __future__ import annotations

import argparse
from pathlib import Path

import matplotlib

matplotlib.use("Agg")  # write files; never open a blocking window
import matplotlib.pyplot as plt
import pandas as pd

# ------------------------------------------------------------------
# Self-contained helpers. This script has no local imports on purpose,
# so it runs from any directory and can be copied around on its own.
# ------------------------------------------------------------------

PALETTE = {
    "primary": "#4a7ba7",
    "secondary": "#a7714a",
    "accent": "#6a8f5f",
    "muted": "#8c8c8c",
    "grid": "#d9d9d9",
}


def apply_style() -> None:
    plt.rcParams.update(
        {
            "figure.dpi": 150,
            "savefig.dpi": 300,
            "savefig.bbox": "tight",
            "font.size": 8,
            "axes.titlesize": 9,
            "axes.labelsize": 8,
            "axes.spines.top": False,
            "axes.spines.right": False,
            "axes.grid": True,
            "grid.color": PALETTE["grid"],
            "grid.linewidth": 0.5,
            "legend.frameon": False,
            "legend.fontsize": 7,
            "xtick.labelsize": 7,
            "ytick.labelsize": 7,
        }
    )


def build_parser(description: str) -> argparse.ArgumentParser:
    parser = argparse.ArgumentParser(description=description)
    parser.add_argument(
        "--data-dir",
        type=Path,
        default=None,
        help="Directory holding the CSV reports. Defaults to searching "
        "the standard project locations.",
    )
    parser.add_argument(
        "--output-dir",
        type=Path,
        default=None,
        help="Where to write the figure. Defaults to outputs/figures/.",
    )
    return parser


def script_dir() -> Path:
    """This script's own directory, falling back to cwd in notebooks."""
    try:
        return Path(__file__).resolve().parent
    except NameError:
        return Path.cwd().resolve()


def project_root() -> Path:
    """Walk upwards until a directory containing outputs/ or data/ is found."""
    here = script_dir()
    for candidate in [here, *here.parents]:
        if (candidate / "outputs").is_dir() or (candidate / "data").is_dir():
            return candidate
    return here


def find_report(filename: str, data_dir: Path | None = None) -> Path:
    if data_dir is not None:
        candidate = data_dir / filename
        if candidate.exists():
            return candidate
        raise SystemExit(f"ERROR: {filename} not found in {data_dir}")

    root = project_root()
    search_paths = [
        root / "outputs" / "data_check" / filename,
        root / "splits" / filename,
        root / filename,
        script_dir() / filename,
        Path.cwd() / filename,
    ]
    for candidate in search_paths:
        if candidate.exists():
            return candidate

    searched = "\n  ".join(str(path) for path in search_paths)
    raise SystemExit(
        f"ERROR: could not find {filename}. Looked in:\n  {searched}\n"
        "Pass --data-dir to point at the reports directly, e.g.\n"
        "  python fig01_image_dimensions.py --data-dir path/to/reports"
    )


def resolve_output_dir(output_dir: Path | None) -> Path:
    target = output_dir or (project_root() / "outputs" / "figures")
    target.mkdir(parents=True, exist_ok=True)
    return target


def save(figure, output_dir: Path, stem: str) -> None:
    """Write both a PDF (for LaTeX) and a PNG (for quick viewing)."""
    for suffix in ("pdf", "png"):
        path = output_dir / f"{stem}.{suffix}"
        figure.savefig(path)
        print(f"  wrote {path}")
    plt.close(figure)


def main() -> None:
    args = build_parser("Figure 3.1 - image dimensions").parse_args()
    apply_style()

    report = find_report("dimension_report.csv", args.data_dir)
    frame = pd.read_csv(report)

    # One row per image: the Task 2 rows repeat the same source dimensions.
    task1 = frame[frame["task"] == "task1"].copy()
    print(f"Loaded {len(task1)} Task 1 image-mask pairs from {report.name}")

    task1["aspect_ratio"] = task1["image_width"] / task1["image_height"]

    figure, axes = plt.subplots(1, 2, figsize=(6.6, 2.5))

    # ---- Panel A: width against height -----------------------------
    axis = axes[0]
    axis.scatter(
        task1["image_width"], task1["image_height"],
        s=6, alpha=0.25, color=PALETTE["primary"], edgecolors="none",
    )
    axis.set_xscale("log")
    axis.set_yscale("log")
    axis.set_xlabel("Width (px, log scale)")
    axis.set_ylabel("Height (px, log scale)")
    axis.set_title("(a) Source resolution")
    axis.axvline(task1["image_width"].median(), color=PALETTE["secondary"],
                 linewidth=0.8, linestyle="--")
    axis.axhline(
        task1["image_height"].median(), color=PALETTE["secondary"],
        linewidth=0.8, linestyle="--",
        label=(f"median {int(task1['image_width'].median())}"
               f"x{int(task1['image_height'].median())}"),
    )
    axis.legend(loc="lower right")

    # ---- Panel B: aspect ratio -------------------------------------
    axis = axes[1]
    axis.hist(task1["aspect_ratio"], bins=60, color=PALETTE["primary"],
              edgecolor="white", linewidth=0.3)
    axis.set_xlabel("Aspect ratio (width / height)")
    axis.set_ylabel("Number of images")

    for percentile, style in ((5, ":"), (50, "--"), (95, ":")):
        axis.axvline(task1["aspect_ratio"].quantile(percentile / 100),
                     color=PALETTE["secondary"], linewidth=0.8, linestyle=style)

    median = task1["aspect_ratio"].median()
    low = task1["aspect_ratio"].quantile(0.05)
    high = task1["aspect_ratio"].quantile(0.95)
    axis.set_title(f"(b) Aspect ratio: median {median:.3f} [{low:.3f}, {high:.3f}]")

    figure.tight_layout()
    save(figure, resolve_output_dir(args.output_dir), "fig_image_dimensions")

    # ---- Numbers quoted in the text --------------------------------
    print("\nValues cited in Section 3.3:")
    print(f"  width  min/median/max : {task1['image_width'].min()} / "
          f"{task1['image_width'].median():.0f} / {task1['image_width'].max()}")
    print(f"  height min/median/max : {task1['image_height'].min()} / "
          f"{task1['image_height'].median():.0f} / {task1['image_height'].max()}")
    pixels = task1["image_width"] * task1["image_height"]
    print(f"  pixel-count spread    : {pixels.max() / pixels.min():.1f}x")
    print(f"  landscape / portrait / square : "
          f"{(task1['aspect_ratio'] > 1).sum()} / "
          f"{(task1['aspect_ratio'] < 1).sum()} / "
          f"{(task1['aspect_ratio'] == 1).sum()}")
    print("\n  most common resolutions:")
    resolutions = (task1["image_width"].astype(str) + "x"
                   + task1["image_height"].astype(str))
    for name, count in resolutions.value_counts().head(5).items():
        print(f"    {name:>12} : {count}")


if __name__ == "__main__":
    main()